#!/usr/bin/env python3

import argparse
import os
import sys
import shutil
import subprocess

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from chiyo_cli.config import init_module_config, load_module_config
from chiyo_cli.fzf import (
    Field,
    STYLE_PRIMARY,
    STYLE_SECONDARY,
    choose_item,
    display_width,
)
from chiyo_cli.output import print_warning


CONFIG_MODULE = "proj"
DEFAULT_CONFIG = {
    "roots": ["~/Documents", "~/Projects", "~/Developer"],
    "markers": [".project", ".git"],
    "exclude": ["node_modules", "Library", ".cache"],
    "fzf_prompt": "proj> ",
}


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Select a project directory with fd and fzf.",
    )
    parser.add_argument(
        "query",
        nargs="*",
        help="Optional text used to pre-filter project names.",
    )
    parser.add_argument(
        "-r",
        "--root",
        action="append",
        help="Search this directory instead of configured roots. Can be used more than once.",
    )
    parser.add_argument(
        "-E",
        "--exclude",
        action="append",
        help="Exclude a glob pattern from fd search. Can be used more than once.",
    )
    parser.add_argument(
        "--config-init",
        action="store_true",
        help="Write the default [proj] config to the shared Chiyo CLI config file.",
    )
    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Always confirm the selected project in fzf.",
    )
    parser.add_argument(
        "--list-completions",
        action="store_true",
        help="Print completion candidates, one per line.",
    )
    return parser.parse_args(argv)


def fail(message, exit_code=1):
    print(f"proj-select: {message}", file=sys.stderr)
    sys.exit(exit_code)


def warn(message):
    print_warning("proj-select", message)


def load_config():
    try:
        config = load_module_config(CONFIG_MODULE, DEFAULT_CONFIG, warn=warn)
    except ValueError as error:
        fail(str(error))

    roots = config.get("roots", [])

    if not isinstance(roots, list) or not roots:
        fail("Invalid config: [proj] roots must be a non-empty list.")

    markers = config.get("markers", [])

    if not isinstance(markers, list) or not markers:
        fail("Invalid config: [proj] markers must be a non-empty list.")

    for marker in markers:
        if not isinstance(marker, str) or not marker:
            fail("Invalid config: [proj] markers must contain non-empty strings.")

    exclude = config.get("exclude", [])

    if not isinstance(exclude, list):
        fail("Invalid config: [proj] exclude must be a list.")

    config["roots"] = roots
    config["markers"] = markers
    config["exclude"] = exclude
    return config


def init_config():
    config_path = init_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    print(f"Wrote {CONFIG_MODULE} config to {config_path}")


def normalize_roots(roots):
    normalized = []

    for root in roots:
        path = os.path.abspath(os.path.expanduser(root))

        if not os.path.isdir(path):
            warn(f"skipping missing project root: {path}")
            continue

        normalized.append(path)

    if not normalized:
        fail("no valid project roots found.")

    return normalized


def require_fd():
    if shutil.which("fd") is None:
        fail("fd is not installed or not in PATH.")


def escape_fd_alternative(value):
    escaped = []

    for char in value:
        if char in r"\.^$*+?{}[]|()":
            escaped.append("\\" + char)
        else:
            escaped.append(char)

    return "".join(escaped)


def marker_pattern(markers):
    alternatives = [escape_fd_alternative(marker) for marker in markers]

    if len(alternatives) == 1:
        return f"^{alternatives[0]}$"

    return "^(" + "|".join(alternatives) + ")$"


def fd_command(roots, markers, exclude=None, max_results=None):
    command = ["fd", "--absolute-path", "--hidden"]
    exclude = exclude or []

    for pattern_to_exclude in exclude:
        command.extend(["--exclude", pattern_to_exclude])

    if max_results is not None:
        command.append(f"--max-results={max_results}")

    return [*command, marker_pattern(markers), *roots]


def run_fd(roots, markers, exclude=None, max_results=None):
    require_fd()
    result = subprocess.run(
        fd_command(roots, markers, exclude, max_results),
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"fd failed while searching projects: {detail}")

    return result.stdout.splitlines()


def project_from_marker(path):
    return os.path.dirname(path.rstrip(os.sep))


def compact_path(path):
    home = os.path.expanduser("~")

    if path == home:
        return "~"

    if path.startswith(home + os.sep):
        return "~" + path[len(home):]

    return path


def project_name(path):
    return os.path.basename(path.rstrip(os.sep))


def unique_paths(paths):
    seen = set()
    unique = []

    for path in paths:
        if not path or path in seen:
            continue

        seen.add(path)
        unique.append(path)

    return unique


def all_projects(roots, markers, exclude, max_results=None):
    marker_paths = run_fd(roots, markers, exclude, max_results)
    projects = [project_from_marker(path) for path in marker_paths]
    return unique_paths(projects)


def filter_projects(projects, query):
    if not query:
        return projects

    query = query.lower()

    return [
        path
        for path in projects
        if query in project_name(path).lower()
    ]


def project_widths(projects):
    return [
        max((display_width(project_name(path)) for path in projects), default=0),
    ]


def project_fields(path, widths):
    name_padding = " " * (widths[0] - display_width(project_name(path)) + 2)
    return [
        Field(project_name(path) + name_padding, STYLE_PRIMARY),
        Field(compact_path(path), STYLE_SECONDARY),
    ]


def choose_project(projects, config):
    widths = project_widths(projects)
    rows = [project_fields(path, widths) for path in projects]
    return choose_item(
        projects,
        rows,
        config["fzf_prompt"],
        "a project",
        fail,
        search_display_fields=[1],
    )


def select_project(projects, config, allow_direct):
    if allow_direct and len(projects) == 1:
        return projects[0]

    return choose_project(projects, config)


def list_completions(projects):
    for path in projects:
        print(project_name(path))


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.config_init:
        init_config()
        return

    config = load_config()
    query = " ".join(args.query)
    roots = normalize_roots(args.root if args.root else config["roots"])
    exclude = config["exclude"] + (args.exclude or [])
    projects = filter_projects(all_projects(roots, config["markers"], exclude), query)

    if args.list_completions:
        list_completions(projects)
        return

    if not projects:
        fail("no projects found.")

    selected_project = select_project(projects, config, bool(query) and not args.confirm)

    if selected_project:
        print(selected_project)


if __name__ == "__main__":
    main()
