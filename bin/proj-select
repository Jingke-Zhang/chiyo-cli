#!/usr/bin/env python3

import argparse
import os
import sys
import shutil
import subprocess

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from chiyo_cli.config import init_module_config, load_module_config


CONFIG_MODULE = "proj"
STYLE_RESET = "\033[0m"
STYLE_PRIMARY = "\033[1;32m"
STYLE_SECONDARY = "\033[3;4m"
DEFAULT_CONFIG = {
    "roots": ["~/Documents", "~/Projects", "~/Developer"],
    "exclude": ["node_modules", "Library", ".cache"],
    "fzf_prompt": "proj> ",
}


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Select a project directory with fd and fzf.",
    )
    parser.add_argument(
        "query",
        nargs="*",
        help="Optional text used to pre-filter project names or paths.",
    )
    parser.add_argument(
        "-r",
        "--root",
        action="append",
        help="Search this directory instead of configured roots. Can be used more than once.",
    )
    parser.add_argument(
        "-E",
        "--exclude",
        action="append",
        help="Exclude a glob pattern from fd search. Can be used more than once.",
    )
    parser.add_argument(
        "--config-init",
        action="store_true",
        help="Write the default [proj] config to the shared Chiyo CLI config file.",
    )
    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Always confirm the selected project in fzf.",
    )
    parser.add_argument(
        "--list-completions",
        action="store_true",
        help="Print completion candidates, one per line.",
    )
    return parser.parse_args(argv)


def fail(message, exit_code=1):
    print(f"proj-select: {message}", file=sys.stderr)
    sys.exit(exit_code)


def warn(message):
    print(f"proj-select: warning: {message}", file=sys.stderr)


def load_config():
    try:
        config = load_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    except ValueError as error:
        fail(str(error))

    roots = config.get("roots", [])

    if not isinstance(roots, list) or not roots:
        fail("Invalid config: [proj] roots must be a non-empty list.")

    exclude = config.get("exclude", [])

    if not isinstance(exclude, list):
        fail("Invalid config: [proj] exclude must be a list.")

    config["roots"] = roots
    config["exclude"] = exclude
    return config


def init_config():
    config_path = init_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    print(f"Wrote {CONFIG_MODULE} config to {config_path}")


def normalize_roots(roots):
    normalized = []

    for root in roots:
        path = os.path.abspath(os.path.expanduser(root))

        if not os.path.isdir(path):
            warn(f"skipping missing project root: {path}")
            continue

        normalized.append(path)

    if not normalized:
        fail("no valid project roots found.")

    return normalized


def require_fd():
    if shutil.which("fd") is None:
        fail("fd is not installed or not in PATH.")


def require_fzf():
    if shutil.which("fzf") is None:
        fail("fzf is not installed or not in PATH.")


def fd_command(roots, exclude=None, max_results=None):
    command = ["fd", "--absolute-path", "--hidden", "--type", "d"]
    exclude = exclude or []

    for pattern_to_exclude in exclude:
        command.extend(["--exclude", pattern_to_exclude])

    if max_results is not None:
        command.append(f"--max-results={max_results}")

    return [*command, "^\\.git$", *roots]


def run_fd(roots, exclude=None, max_results=None):
    require_fd()
    result = subprocess.run(
        fd_command(roots, exclude, max_results),
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"fd failed while searching projects: {detail}")

    return result.stdout.splitlines()


def project_from_git_dir(path):
    return os.path.dirname(path.rstrip(os.sep))


def compact_path(path):
    home = os.path.expanduser("~")

    if path == home:
        return "~"

    if path.startswith(home + os.sep):
        return "~" + path[len(home):]

    return path


def project_name(path):
    return os.path.basename(path.rstrip(os.sep))


def style_text(value, style):
    if not style:
        return value

    return f"{style}{value}{STYLE_RESET}"


def unique_paths(paths):
    seen = set()
    unique = []

    for path in paths:
        if not path or path in seen:
            continue

        seen.add(path)
        unique.append(path)

    return unique


def all_projects(roots, exclude, max_results=None):
    git_dirs = run_fd(roots, exclude, max_results)
    projects = [project_from_git_dir(path) for path in git_dirs]
    return unique_paths(projects)


def filter_projects(projects, query):
    if not query:
        return projects

    query = query.lower()

    return [
        path
        for path in projects
        if query in project_name(path).lower() or query in compact_path(path).lower()
    ]


def format_project_choice(path):
    name = style_text(project_name(path), STYLE_PRIMARY)
    compact = style_text(compact_path(path), STYLE_SECONDARY)
    return f"{name}\t{compact}\t{path}"


def parse_choice(choice):
    if "\t" not in choice:
        return choice

    return choice.rsplit("\t", 1)[1]


def choose_project(projects, config):
    require_fzf()
    result = subprocess.run(
        [
            "fzf",
            f"--prompt={config['fzf_prompt']}",
            "--ansi",
            "--with-nth=1,2",
            "--delimiter=\t",
        ],
        input="\n".join(format_project_choice(path) for path in projects),
        text=True,
        capture_output=True,
        check=False,
    )

    if result.returncode == 130:
        return None

    if result.returncode != 0:
        fail("fzf failed while selecting a project.")

    selected = result.stdout.strip()

    if not selected:
        return None

    return parse_choice(selected)


def select_project(projects, config, allow_direct):
    if allow_direct and len(projects) == 1:
        return projects[0]

    return choose_project(projects, config)


def list_completions(projects):
    for path in projects:
        print(project_name(path))


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.config_init:
        init_config()
        return

    config = load_config()
    query = " ".join(args.query)
    roots = normalize_roots(args.root if args.root else config["roots"])
    exclude = config["exclude"] + (args.exclude or [])
    projects = filter_projects(all_projects(roots, exclude), query)

    if args.list_completions:
        list_completions(projects)
        return

    if not projects:
        fail("no projects found.")

    selected_project = select_project(projects, config, bool(query) and not args.confirm)

    if selected_project:
        print(selected_project)


if __name__ == "__main__":
    main()
