#!/usr/bin/env python3

import argparse
import os
import sys
import shutil
import subprocess
import unicodedata

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from chiyo_cli.config import init_module_config, load_module_config


CONFIG_MODULE = "app"
STYLE_RESET = "\033[0m"
STYLE_PRIMARY = "\033[1;32m"
STYLE_PATH = "\033[3;4m"
CHOICE_COLUMN_GAP = 2
DEFAULT_CONFIG = {
    "fzf_prompt": "app> ",
    "alias": {},
}


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Search installed macOS applications with fzf and launch one.",
    )
    parser.add_argument(
        "query",
        nargs="*",
        help="Optional text used to pre-filter application names or resolve aliases.",
    )
    parser.add_argument(
        "--config-init",
        action="store_true",
        help="Write the default [app] config to the shared Chiyo CLI config file.",
    )
    parser.add_argument(
        "--print-name",
        action="store_true",
        help="Print the selected application name instead of opening it.",
    )
    return parser.parse_args(argv)


def fail(message, exit_code=1):
    print(f"app: {message}", file=sys.stderr)
    sys.exit(exit_code)


def load_config():
    try:
        config = load_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    except ValueError as error:
        fail(str(error))

    alias = config.get("alias", {})

    if not isinstance(alias, dict):
        fail("Invalid config: [app.alias] must be a table.")

    config["alias"] = alias
    return config


def init_config():
    config_path = init_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    print(f"Wrote {CONFIG_MODULE} config to {config_path}")


def app_name_from_path(path):
    name = os.path.basename(path)

    if name.endswith(".app"):
        name = name[:-4]

    return name


def discover_apps():
    if shutil.which("mdfind") is None:
        fail("macOS 'mdfind' command is not available.")

    result = subprocess.run(
        ["mdfind", 'kMDItemContentType == "com.apple.application-bundle"'],
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"could not discover applications: {detail}")

    apps = []
    seen_paths = set()

    for path in result.stdout.splitlines():
        if path in seen_paths:
            continue

        name = app_name_from_path(path)

        if not name:
            continue

        seen_paths.add(path)
        apps.append(
            {
                "name": name,
                "path": path,
            }
        )

    return sorted(apps, key=lambda app: (app["name"].lower(), app["path"].lower()))


def resolve_alias(query, aliases):
    if not query:
        return None

    return aliases.get(query)


def alias_for_app(name, aliases):
    matching_aliases = [
        alias
        for alias, app_name in aliases.items()
        if app_name == name
    ]

    if not matching_aliases:
        return ""

    return sorted(matching_aliases, key=str.lower)[0]


def filter_apps(apps, query, aliases=None):
    if not query:
        return apps

    query = query.lower()
    aliases = aliases or {}

    return [
        app
        for app in apps
        if query in app["name"].lower()
        or query in app["path"].lower()
        or query in alias_for_app(app["name"], aliases).lower()
    ]


def style_primary(value):
    return f"{STYLE_PRIMARY}{value}{STYLE_RESET}"


def style_path(value):
    return f"{STYLE_PATH}{value}{STYLE_RESET}"


def display_width(value):
    width = 0

    for char in value:
        if unicodedata.combining(char):
            continue

        if unicodedata.east_asian_width(char) in ("F", "W"):
            width += 2
        else:
            width += 1

    return width


def format_choice(index, app, alias, name_width, alias_width):
    name = app["name"]
    path = app["path"]
    name_padding = " " * (
        name_width - display_width(name) + CHOICE_COLUMN_GAP
    )
    alias_padding = " " * (
        alias_width - display_width(alias) + CHOICE_COLUMN_GAP
    )

    if alias:
        visible_name = name
        visible_alias = style_primary(alias)
    else:
        visible_name = style_primary(name)
        visible_alias = alias

    visible_choice = (
        f"{visible_name}{name_padding}"
        f"{visible_alias}{alias_padding}"
        f"{style_path(path)}"
    )
    return f"{visible_choice}\t#{index}"


def choose_app(apps, config):
    if shutil.which("fzf") is None:
        fail("fzf is not installed or not in PATH.")

    aliases = config.get("alias", {})
    app_aliases = [alias_for_app(app["name"], aliases) for app in apps]
    name_width = max(display_width(app["name"]) for app in apps)
    alias_width = max([display_width(alias) for alias in app_aliases] or [0])
    choices = [
        format_choice(index, app, app_aliases[index], name_width, alias_width)
        for index, app in enumerate(apps)
    ]

    result = subprocess.run(
        [
            "fzf",
            f"--prompt={config['fzf_prompt']}",
            "--ansi",
            "--with-nth=1",
            "--delimiter=\t",
        ],
        input="\n".join(choices),
        text=True,
        capture_output=True,
        check=False,
    )

    if result.returncode == 130:
        return None

    if result.returncode != 0:
        fail("fzf failed while selecting an application.")

    selected = result.stdout.strip()

    if not selected:
        return None

    index = int(selected.rsplit("#", 1)[1])
    return apps[index]


def open_app(app):
    if shutil.which("open") is None:
        fail("macOS 'open' command is not available.")

    result = subprocess.run(
        ["open", app["path"]],
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"could not open application '{app['name']}': {detail}")


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.config_init:
        init_config()
        return

    config = load_config()
    query = " ".join(args.query)
    alias_target = resolve_alias(query, config["alias"])
    app_query = alias_target or query

    apps = discover_apps()
    apps = filter_apps(apps, app_query, config["alias"])

    if not apps:
        fail("no applications found.")

    selected_app = choose_app(apps, config)

    if not selected_app:
        return

    if args.print_name:
        print(selected_app["name"])
        return

    open_app(selected_app)


if __name__ == "__main__":
    main()
