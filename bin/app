#!/usr/bin/env python3

import argparse
import os
import sys
import shutil
import subprocess

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from chiyo_cli.config import init_module_config, load_module_config
from chiyo_cli.fzf import Field, STYLE_PRIMARY, STYLE_SECONDARY, choose_item
from chiyo_cli.output import print_warning


CONFIG_MODULE = "app"
DEFAULT_CONFIG = {
    "fzf_prompt": "app> ",
    "alias": {},
}


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Search installed macOS applications with fzf and launch one.",
    )
    parser.add_argument(
        "query",
        nargs="*",
        help="Optional text used to pre-filter application names or resolve aliases.",
    )
    parser.add_argument(
        "--config-init",
        action="store_true",
        help="Write the default [app] config to the shared Chiyo CLI config file.",
    )
    parser.add_argument(
        "--print-name",
        action="store_true",
        help="Print the selected application name instead of opening it.",
    )
    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Always confirm the selected application in fzf.",
    )
    parser.add_argument(
        "--list-completions",
        action="store_true",
        help="Print completion candidates, one per line.",
    )
    return parser.parse_args(argv)


def fail(message, exit_code=1):
    print(f"app: {message}", file=sys.stderr)
    sys.exit(exit_code)


def warn(message):
    print_warning("app", message)


def load_config():
    try:
        config = load_module_config(CONFIG_MODULE, DEFAULT_CONFIG, warn=warn)
    except ValueError as error:
        fail(str(error))

    alias = config.get("alias", {})

    if not isinstance(alias, dict):
        fail("Invalid config: [app.alias] must be a table.")

    config["alias"] = alias
    return config


def init_config():
    config_path = init_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    print(f"Wrote {CONFIG_MODULE} config to {config_path}")


def app_name_from_path(path):
    name = os.path.basename(path)

    if name.endswith(".app"):
        name = name[:-4]

    return name


def discover_apps():
    if shutil.which("mdfind") is None:
        fail("macOS 'mdfind' command is not available.")

    # Spotlight is the source of truth here because it finds system apps,
    # user-installed apps, and nested application bundles without hard-coding
    # every possible Applications directory.
    result = subprocess.run(
        ["mdfind", 'kMDItemContentType == "com.apple.application-bundle"'],
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"could not discover applications: {detail}")

    apps = []
    seen_paths = set()

    for path in result.stdout.splitlines():
        if path in seen_paths:
            continue

        name = app_name_from_path(path)

        if not name:
            continue

        seen_paths.add(path)
        apps.append(
            {
                "name": name,
                "path": path,
            }
        )

    return sorted(apps, key=lambda app: (app["name"].lower(), app["path"].lower()))


def resolve_alias(query, aliases):
    if not query:
        return None

    return aliases.get(query)


def alias_for_app(name, aliases):
    # Aliases are configured as alias -> app name. For display we need the
    # reverse direction, and we pick one stable alias when several point to the
    # same application.
    matching_aliases = [
        alias
        for alias, app_name in aliases.items()
        if app_name == name
    ]

    if not matching_aliases:
        return ""

    return sorted(matching_aliases, key=str.lower)[0]


def filter_apps(apps, query, aliases=None):
    if not query:
        return apps

    query = query.lower()
    aliases = aliases or {}

    return [
        app
        for app in apps
        if query in app["name"].lower()
        or query in alias_for_app(app["name"], aliases).lower()
    ]


def app_fields(app, alias):
    # The primary green label marks the thing the user can type. With an alias,
    # the alias becomes primary and the original app name stays plain.
    if alias:
        name_style = ""
        alias_style = STYLE_PRIMARY
    else:
        name_style = STYLE_PRIMARY
        alias_style = ""

    return [
        Field(app["name"], name_style),
        Field(alias, alias_style),
        Field(app["path"], STYLE_SECONDARY),
    ]


def choose_app(apps, config):
    aliases = config.get("alias", {})
    app_aliases = [alias_for_app(app["name"], aliases) for app in apps]
    rows = [
        app_fields(app, app_aliases[index])
        for index, app in enumerate(apps)
    ]
    # Search names and aliases only. Paths remain visible for duplicate app
    # names but should not cause directory-name matches.
    filter_rows = [
        [app["name"], app_aliases[index]]
        for index, app in enumerate(apps)
    ]
    return choose_item(
        apps,
        rows,
        config["fzf_prompt"],
        "an application",
        fail,
        filter_rows=filter_rows,
    )


def list_completions(apps):
    seen = set()

    for app in apps:
        name = app["name"]

        if name in seen:
            continue

        seen.add(name)
        print(name)


def select_app(apps, config, allow_direct):
    if allow_direct and len(apps) == 1:
        return apps[0]

    return choose_app(apps, config)


def open_app(app):
    if shutil.which("open") is None:
        fail("macOS 'open' command is not available.")

    if app.get("path"):
        command = ["open", app["path"]]
    else:
        command = ["open", "-a", app["name"]]

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"could not open application '{app['name']}': {detail}")


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.config_init:
        init_config()
        return

    config = load_config()

    if args.list_completions:
        list_completions(discover_apps())
        return

    query = " ".join(args.query)
    alias_target = resolve_alias(query, config["alias"])

    # Exact aliases are intentionally stronger than search matches. Since alias
    # keys are unique, they can launch directly unless the user asks to confirm.
    if alias_target and not args.confirm:
        selected_app = {
            "name": alias_target,
            "path": None,
        }
    else:
        apps = discover_apps()
        apps = filter_apps(apps, query, config["alias"])

        if not apps:
            fail("no applications found.")

        selected_app = select_app(apps, config, bool(query) and not args.confirm)

    if not selected_app:
        return

    if args.print_name:
        print(selected_app["name"])
        return

    open_app(selected_app)


if __name__ == "__main__":
    main()
