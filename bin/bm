#!/usr/bin/env python3

import argparse
import os
import sys
import plistlib
import shutil
import subprocess

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from chiyo_cli.config import CONFIG_PATH, init_module_config, load_module_config
from chiyo_cli.fzf import Field, STYLE_PRIMARY, STYLE_SECONDARY, choose_item
from chiyo_cli.output import print_warning


CONFIG_MODULE = "bm"

# Keep universal defaults in code. User-specific preferences can live in
# ~/.config/chiyo-cli/config.toml under the [bm] table.
DEFAULT_CONFIG = {
    "bookmarks_path": "~/Library/Safari/Bookmarks.plist",
    "skip_folders": [
        "Bookmarks",
        "BookmarksMenu",
        "Tab Group Favorites",
        "com.apple.ReadingList",
        "Reading List",
    ],
    "fzf_prompt": "bm> ",
    "browser": "Safari",
}


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Search Safari bookmarks with fzf and open the selected URL.",
    )
    parser.add_argument(
        "query",
        nargs="*",
        help="Optional text used to pre-filter bookmark display names.",
    )
    parser.add_argument(
        "--config-init",
        action="store_true",
        help="Write the default [bm] config to the shared Chiyo CLI config file.",
    )
    parser.add_argument(
        "--print-url",
        action="store_true",
        help="Print the selected URL instead of opening it.",
    )
    parser.add_argument(
        "--browser",
        help="Override the configured browser for this run.",
    )
    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Always confirm the selected bookmark in fzf.",
    )
    parser.add_argument(
        "--list-completions",
        action="store_true",
        help="Print completion candidates, one per line.",
    )
    return parser.parse_args(argv)


def fail(message, exit_code=1):
    print(f"bm: {message}", file=sys.stderr)
    sys.exit(exit_code)


def warn(message):
    print_warning("bm", message)


def load_config():
    try:
        config = load_module_config(
            CONFIG_MODULE,
            DEFAULT_CONFIG,
            config_path=CONFIG_PATH,
            warn=warn,
        )
    except ValueError as error:
        fail(str(error))

    config["bookmarks_path"] = os.path.expanduser(config["bookmarks_path"])
    config["skip_folders"] = set(config["skip_folders"])
    config["rename_folders"] = config.get("rename_folders", {})

    return config


def init_config():
    config_path = init_module_config(
        CONFIG_MODULE,
        DEFAULT_CONFIG,
        config_path=CONFIG_PATH,
    )
    print(f"Wrote {CONFIG_MODULE} config to {config_path}")


def get_node_name(node):
    # Safari stores names in different fields depending on the bookmark node.
    uri_dict = node.get("URIDictionary")

    if isinstance(uri_dict, dict):
        title = uri_dict.get("title")
        if title:
            return title

    return node.get("Title") or node.get("WebBookmarkTitle")


def normalize_path(parts, skip_folders, rename_folders):
    # Convert Safari's internal folder names into display paths shown in fzf.
    normalized = []

    for part in parts:
        if not part:
            continue

        if part in skip_folders:
            continue

        part = rename_folders.get(part, part)
        normalized.append(part)

    return normalized


def walk_bookmarks(node, path, results, config):
    # Safari bookmarks are stored as a nested plist tree.
    name = get_node_name(node)

    if name:
        path = path + [name]

    if "URLString" in node:
        normalized_path = normalize_path(
            path,
            config["skip_folders"],
            config["rename_folders"],
        )

        if normalized_path:
            display_name = "/".join(normalized_path)
            url = node["URLString"]
            results.append((display_name, url))

        return

    for child in node.get("Children", []):
        walk_bookmarks(child, path, results, config)


def load_bookmarks(config):
    bookmarks_path = config["bookmarks_path"]

    if not os.path.exists(bookmarks_path):
        fail(
            f"bookmark file not found: {bookmarks_path}\n"
            f"Run 'bm --config-init' and add bookmarks_path to "
            f"{os.path.expanduser(CONFIG_PATH)} "
            "if your bookmarks live somewhere else."
        )

    with open(bookmarks_path, "rb") as file:
        data = plistlib.load(file)

    results = []
    walk_bookmarks(data, [], results, config)

    # Safari can expose the same bookmark more than once through internal
    # folders. Deduplicate after path normalization so fzf shows each row once.
    seen = set()
    unique_results = []

    for display_name, url in results:
        key = (display_name, url)

        if key in seen:
            continue

        seen.add(key)
        unique_results.append((display_name, url))

    return unique_results


def filter_bookmarks(bookmarks, query):
    if not query:
        return bookmarks

    query = query.lower()

    return [
        (display_name, url)
        for display_name, url in bookmarks
        if query in display_name.lower() or query in url.lower()
    ]


def choose_bookmark(bookmarks, config):
    rows = [
        [
            Field(display_name, STYLE_PRIMARY),
            Field(url, STYLE_SECONDARY),
        ]
        for display_name, url in bookmarks
    ]
    selected = choose_item(
        bookmarks,
        rows,
        config["fzf_prompt"],
        "a bookmark",
        fail,
    )

    if selected is None:
        return None

    return selected[1]


def list_completions(bookmarks):
    for display_name, _url in bookmarks:
        print(display_name)


def select_bookmark(bookmarks, config, allow_direct):
    # Direct open keeps single-result searches fast; --confirm routes even a
    # single match through fzf when the user wants to inspect it first.
    if allow_direct and len(bookmarks) == 1:
        return bookmarks[0][1]

    return choose_bookmark(bookmarks, config)


def open_url(url, browser):
    if shutil.which("open") is None:
        fail("macOS 'open' command is not available.")

    result = subprocess.run(
        ["open", "-a", browser, url],
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"could not open URL with browser '{browser}': {detail}")


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.config_init:
        init_config()
        return

    config = load_config()

    if args.browser:
        config["browser"] = args.browser

    bookmarks = load_bookmarks(config)

    if args.list_completions:
        list_completions(bookmarks)
        return

    query = " ".join(args.query)

    bookmarks = filter_bookmarks(bookmarks, query)

    if not bookmarks:
        fail("no bookmarks found.")

    url = select_bookmark(bookmarks, config, bool(query) and not args.confirm)

    if not url:
        return

    if args.print_url:
        print(url)
        return

    open_url(url, config["browser"])


if __name__ == "__main__":
    main()
