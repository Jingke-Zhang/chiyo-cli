#!/usr/bin/env python3

import argparse
import os
import sys
import shutil
import subprocess

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from chiyo_cli.config import init_module_config, load_module_config


CONFIG_MODULE = "gop"
STYLE_RESET = "\033[0m"
STYLE_DIR = "\033[1;34m"
STYLE_FILE = ""
STYLE_EXECUTABLE = "\033[1;32m"
DEFAULT_CONFIG = {
    "roots": ["~"],
    "fzf_prompt": "gop> ",
}


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Select a file or directory path with fd and fzf.",
    )
    parser.add_argument(
        "query",
        nargs="*",
        help="Optional fd pattern used to pre-filter paths.",
    )
    parser.add_argument(
        "-r",
        "--root",
        action="append",
        help="Search this directory instead of configured roots. Can be used more than once.",
    )
    parser.add_argument(
        "--config-init",
        action="store_true",
        help="Write the default [gop] config to the shared Chiyo CLI config file.",
    )
    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Always confirm the selected path in fzf.",
    )
    return parser.parse_args(argv)


def fail(message, exit_code=1):
    print(f"gop-select: {message}", file=sys.stderr)
    sys.exit(exit_code)


def load_config():
    try:
        config = load_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    except ValueError as error:
        fail(str(error))

    roots = config.get("roots", [])

    if not isinstance(roots, list) or not roots:
        fail("Invalid config: [gop] roots must be a non-empty list.")

    config["roots"] = [os.path.abspath(os.path.expanduser(root)) for root in roots]
    return config


def init_config():
    config_path = init_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    print(f"Wrote {CONFIG_MODULE} config to {config_path}")


def normalize_roots(roots):
    return [os.path.abspath(os.path.expanduser(root)) for root in roots]


def fd_command(query, roots, max_results=None):
    pattern = query or "."
    command = ["fd", "--absolute-path"]

    if max_results is not None:
        command.append(f"--max-results={max_results}")

    return [*command, pattern, *roots]


def require_fd():
    if shutil.which("fd") is None:
        fail("fd is not installed or not in PATH.")


def require_fzf():
    if shutil.which("fzf") is None:
        fail("fzf is not installed or not in PATH.")


def run_fd(query, roots, max_results=None):
    require_fd()
    result = subprocess.run(
        fd_command(query, roots, max_results),
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"fd failed while searching paths: {detail}")

    return result.stdout.splitlines()


def compact_path(path):
    home = os.path.expanduser("~")

    if path == home:
        return "~"

    if path.startswith(home + os.sep):
        return "~" + path[len(home):]

    return path


def path_kind(path):
    if os.path.isdir(path):
        return "dir"

    if os.access(path, os.X_OK):
        return "exec"

    return "file"


def style_for_kind(kind):
    if kind == "dir":
        return STYLE_DIR

    if kind == "exec":
        return STYLE_EXECUTABLE

    return STYLE_FILE


def style_text(value, style):
    if not style:
        return value

    return f"{style}{value}{STYLE_RESET}"


def format_path_choice(path):
    kind = path_kind(path)
    visible_path = style_text(compact_path(path), style_for_kind(kind))
    return f"{visible_path}\t{path}"


def parse_choice(choice):
    if "\t" not in choice:
        return choice

    return choice.rsplit("\t", 1)[1]


def unique_paths(paths):
    seen = set()
    unique = []

    for path in paths:
        if not path or path in seen:
            continue

        seen.add(path)
        unique.append(path)

    return unique


def choose_path(paths, config):
    require_fzf()
    result = subprocess.run(
        [
            "fzf",
            f"--prompt={config['fzf_prompt']}",
            "--ansi",
            "--with-nth=1",
            "--delimiter=\t",
        ],
        input="\n".join(format_path_choice(path) for path in paths),
        text=True,
        capture_output=True,
        check=False,
    )

    if result.returncode == 130:
        return None

    if result.returncode != 0:
        fail("fzf failed while selecting a path.")

    selected = result.stdout.strip()

    if not selected:
        return None

    return parse_choice(selected)


def choose_path_stream(query, roots, config):
    require_fd()
    require_fzf()
    fd_process = subprocess.Popen(
        fd_command(query, roots),
        stdout=subprocess.PIPE,
        text=True,
    )

    fzf_process = subprocess.Popen(
        [
            "fzf",
            f"--prompt={config['fzf_prompt']}",
            "--ansi",
            "--with-nth=1",
            "--delimiter=\t",
        ],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    try:
        if fd_process.stdout is not None and fzf_process.stdin is not None:
            for path in fd_process.stdout:
                path = path.rstrip("\n")

                if not path:
                    continue

                try:
                    fzf_process.stdin.write(format_path_choice(path) + "\n")
                except BrokenPipeError:
                    break

        if fzf_process.stdin is not None:
            fzf_process.stdin.close()

        stdout = fzf_process.stdout.read() if fzf_process.stdout is not None else ""
        if fzf_process.stderr is not None:
            fzf_process.stderr.read()
        returncode = fzf_process.wait()
    finally:
        if fd_process.stdout is not None:
            fd_process.stdout.close()

        fd_process.wait()

    if returncode == 130:
        return None

    if returncode != 0:
        fail("fzf failed while selecting a path.")

    selected = stdout.strip()

    if not selected:
        return None

    return parse_choice(selected)


def select_path(paths, config, allow_direct):
    if allow_direct and len(paths) == 1:
        return paths[0]

    return choose_path(paths, config)


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.config_init:
        init_config()
        return

    config = load_config()
    query = " ".join(args.query)
    roots = normalize_roots(args.root) if args.root else config["roots"]

    if query and not args.confirm:
        paths = unique_paths(run_fd(query, roots, max_results=2))

        if not paths:
            fail("no paths found.")

        if len(paths) == 1:
            selected_path = paths[0]
        else:
            selected_path = choose_path_stream(query, roots, config)
    else:
        selected_path = choose_path_stream(query, roots, config)

    if selected_path:
        print(selected_path)


if __name__ == "__main__":
    main()
