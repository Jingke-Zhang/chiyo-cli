#!/usr/bin/env python3

import argparse
import os
import re
import sys
import shutil
import subprocess

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

if REPO_ROOT not in sys.path:
    sys.path.insert(0, REPO_ROOT)

from chiyo_cli.config import init_module_config, load_module_config
from chiyo_cli.fzf import Field, choose_item, field_widths, format_row
from chiyo_cli.output import print_warning


CONFIG_MODULE = "gop"
STYLE_DIR = "\033[1;34m"
STYLE_FILE = ""
STYLE_EXECUTABLE = "\033[1;32m"
ANSI_PATTERN = re.compile(r"\033\[[0-9;]*m")
DEFAULT_CONFIG = {
    "roots": ["~/Documents", "~/Downloads", "~/Desktop"],
    "exclude": ["Library", "node_modules", "OrbStack"],
    "fzf_prompt": "gop> ",
}


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Select a file or directory path with fd and fzf.",
    )
    parser.add_argument(
        "query",
        nargs="*",
        help="Optional fd pattern used to pre-filter paths.",
    )
    parser.add_argument(
        "-r",
        "--root",
        action="append",
        help="Search this directory instead of configured roots. Can be used more than once.",
    )
    parser.add_argument(
        "-E",
        "--exclude",
        action="append",
        help="Exclude a glob pattern from fd search. Can be used more than once.",
    )
    parser.add_argument(
        "--config-init",
        action="store_true",
        help="Write the default [gop] config to the shared Chiyo CLI config file.",
    )
    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Always confirm the selected path in fzf.",
    )
    parser.add_argument(
        "--list-completions",
        action="store_true",
        help="Print completion candidates, one per line.",
    )
    return parser.parse_args(argv)


def fail(message, exit_code=1):
    print(f"gop-select: {message}", file=sys.stderr)
    sys.exit(exit_code)


def warn(message):
    print_warning("gop-select", message)


def load_config():
    try:
        config = load_module_config(CONFIG_MODULE, DEFAULT_CONFIG, warn=warn)
    except ValueError as error:
        fail(str(error))

    roots = config.get("roots", [])

    if not isinstance(roots, list) or not roots:
        fail("Invalid config: [gop] roots must be a non-empty list.")

    exclude = config.get("exclude", [])

    if not isinstance(exclude, list):
        fail("Invalid config: [gop] exclude must be a list.")

    config["roots"] = normalize_roots(roots)
    config["exclude"] = exclude
    return config


def init_config():
    config_path = init_module_config(CONFIG_MODULE, DEFAULT_CONFIG)
    print(f"Wrote {CONFIG_MODULE} config to {config_path}")


def normalize_roots(roots):
    # Defaults include common macOS folders that may not exist on every machine.
    # Missing roots should be noisy enough to explain a smaller search space but
    # not fatal while at least one usable root remains.
    normalized = []

    for root in roots:
        path = os.path.abspath(os.path.expanduser(root))

        if not os.path.isdir(path):
            warn(f"skipping missing search root: {path}")
            continue

        normalized.append(path)

    if not normalized:
        fail("no valid search roots found.")

    return normalized


def fd_command(query, roots, exclude=None, max_results=None):
    # fd treats "." as "match everything", which gives the interactive empty
    # query mode a natural full-root listing.
    pattern = query or "."
    command = ["fd", "--absolute-path"]
    exclude = exclude or []

    for pattern_to_exclude in exclude:
        command.extend(["--exclude", pattern_to_exclude])

    if max_results is not None:
        command.append(f"--max-results={max_results}")

    return [*command, pattern, *roots]


def require_fd():
    if shutil.which("fd") is None:
        fail("fd is not installed or not in PATH.")


def require_fzf():
    if shutil.which("fzf") is None:
        fail("fzf is not installed or not in PATH.")


def run_fd(query, roots, exclude=None, max_results=None):
    require_fd()
    result = subprocess.run(
        fd_command(query, roots, exclude, max_results),
        capture_output=True,
        text=True,
        check=False,
    )

    if result.returncode != 0:
        detail = result.stderr.strip() or "unknown error"
        fail(f"fd failed while searching paths: {detail}")

    return result.stdout.splitlines()


def compact_path(path):
    home = os.path.expanduser("~")

    if path == home:
        return "~"

    if path.startswith(home + os.sep):
        return "~" + path[len(home):]

    return path


def path_kind(path):
    if os.path.isdir(path):
        return "dir"

    if os.access(path, os.X_OK):
        return "exec"

    return "file"


def style_for_kind(kind):
    if kind == "dir":
        return STYLE_DIR

    if kind == "exec":
        return STYLE_EXECUTABLE

    return STYLE_FILE


def path_fields(path):
    kind = path_kind(path)
    return [Field(compact_path(path), style_for_kind(kind))]


def path_filter_fields(path):
    # Search the compact path users usually type and keep the exact absolute
    # path hidden so selection can return an unambiguous filesystem target.
    return [compact_path(path), path]


def format_path_choice(path):
    # Streamed gop selection cannot use choose_item because fd output arrives
    # incrementally, but it still uses the shared row format: display fields,
    # hidden filter fields, and a hidden index suffix.
    fields = path_fields(path)
    return format_row(0, fields, field_widths([fields]), path_filter_fields(path))


def parse_choice(choice):
    # During tests or unexpected fzf output we may receive a raw path. Accept it
    # rather than failing because the shell wrapper can still act on the path.
    if "\t" not in choice:
        return choice

    without_index = choice.rsplit("\t#", 1)[0]
    return ANSI_PATTERN.sub("", without_index.rsplit("\t", 1)[1])


def unique_paths(paths):
    seen = set()
    unique = []

    for path in paths:
        if not path or path in seen:
            continue

        seen.add(path)
        unique.append(path)

    return unique


def choose_path(paths, config):
    rows = [path_fields(path) for path in paths]
    filter_rows = [path_filter_fields(path) for path in paths]
    return choose_item(
        paths,
        rows,
        config["fzf_prompt"],
        "a path",
        fail,
        filter_rows=filter_rows,
    )


def choose_path_stream(query, roots, exclude, config):
    # gop streams fd output through a tiny formatter before fzf so large roots
    # can become interactive immediately instead of waiting for a full scan.
    require_fd()
    require_fzf()
    fd_process = subprocess.Popen(
        fd_command(query, roots, exclude),
        stdout=subprocess.PIPE,
        text=True,
    )

    fzf_process = subprocess.Popen(
        [
            "fzf",
            f"--prompt={config['fzf_prompt']}",
            "--ansi",
            "--with-nth=1",
            "--nth=2,3",
            "--delimiter=\t",
        ],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )

    try:
        if fd_process.stdout is not None and fzf_process.stdin is not None:
            for path in fd_process.stdout:
                path = path.rstrip("\n")

                if not path:
                    continue

                try:
                    fzf_process.stdin.write(format_path_choice(path) + "\n")
                except BrokenPipeError:
                    break

        if fzf_process.stdin is not None:
            fzf_process.stdin.close()

        stdout = fzf_process.stdout.read() if fzf_process.stdout is not None else ""
        if fzf_process.stderr is not None:
            fzf_process.stderr.read()
        returncode = fzf_process.wait()
    finally:
        if fd_process.stdout is not None:
            fd_process.stdout.close()

        fd_process.wait()

    if returncode == 130:
        return None

    if returncode != 0:
        fail("fzf failed while selecting a path.")

    selected = stdout.strip()

    if not selected:
        return None

    return parse_choice(selected)


def select_path(paths, config, allow_direct):
    # Non-confirmed queries probe fd with --max-results=2 first. One result can
    # open directly; two means "there may be more", so fall back to streaming fzf.
    if allow_direct and len(paths) == 1:
        return paths[0]

    return choose_path(paths, config)


def list_completions(query, roots, exclude):
    for path in unique_paths(run_fd(query, roots, exclude, max_results=200)):
        print(compact_path(path))


def main(argv=None):
    args = parse_args(argv if argv is not None else sys.argv[1:])

    if args.config_init:
        init_config()
        return

    config = load_config()
    query = " ".join(args.query)
    roots = normalize_roots(args.root) if args.root else config["roots"]
    exclude = config["exclude"] + (args.exclude or [])

    if args.list_completions:
        list_completions(query, roots, exclude)
        return

    if query and not args.confirm:
        paths = unique_paths(run_fd(query, roots, exclude, max_results=2))

        if not paths:
            fail("no paths found.")

        if len(paths) == 1:
            selected_path = paths[0]
        else:
            selected_path = choose_path_stream(query, roots, exclude, config)
    else:
        selected_path = choose_path_stream(query, roots, exclude, config)

    if selected_path:
        print(selected_path)


if __name__ == "__main__":
    main()
